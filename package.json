{
  "name": "@lowcountrydigitalworks/gas-engine",
  "version": "0.18.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --permission --allow-fs-read=. --allow-fs-write=local-artifacts --allow-fs-write=\"local-artifacts/*\" --import ./dist/tests/no-network.js --test --test-isolation=none dist/tests/contracts/*.test.js dist/tests/persistence/*.test.js dist/tests/ingestion/*.test.js dist/tests/adapters/*.test.js dist/tests/analysis/*.test.js dist/tests/review/*.test.js dist/tests/operator/*.test.js",
    "schemas:generate": "node dist/scripts/schemas.js",
    "schemas:check": "node dist/scripts/schemas.js --check",
    "preview:operator": "node --permission --allow-fs-read=. --allow-fs-write=local-artifacts --allow-fs-write=\"local-artifacts/*\" --import ./dist/tests/no-network.js dist/scripts/operator-preview.js",
    "check": "npm run typecheck && npm run build && npm test && npm run schemas:check && npm run preview:operator && npm run preview:discovery && npm run preview:ai-visibility && npm run preview:service-brief && npm run preview:decision-cycle && npm run preview:workspace && npm run preview:service-run",
    "preview:discovery": "node --permission --allow-fs-read=. --allow-fs-write=local-artifacts --allow-fs-write=\"local-artifacts/*\" --import ./dist/tests/no-network.js dist/scripts/discovery-diagnostics-preview.js",
    "preview:ai-visibility": "node --permission --allow-fs-read=. --allow-fs-write=local-artifacts --allow-fs-write=\"local-artifacts/*\" --import ./dist/tests/no-network.js dist/scripts/ai-visibility-preview.js",
    "preview:service-brief": "node --permission --allow-fs-read=. --allow-fs-write=local-artifacts --allow-fs-write=\"local-artifacts/*\" --import ./dist/tests/no-network.js dist/scripts/service-brief-preview.js",
    "preview:decision-cycle": "node --permission --allow-fs-read=. --allow-fs-write=local-artifacts --allow-fs-write=\"local-artifacts/*\" --import ./dist/tests/no-network.js dist/scripts/decision-cycle-preview.js",
    "preview:workspace": "node --permission --allow-fs-read=. --allow-fs-write=local-artifacts --allow-fs-write=\"local-artifacts/*\" --import ./dist/tests/no-network.js dist/scripts/operator-workspace-preview.js",
    "preview:service-run": "node --permission --allow-fs-read=. --allow-fs-write=local-artifacts --allow-fs-write=\"local-artifacts/*\" --import ./dist/tests/no-network.js dist/scripts/service-run-preview.js"
  },
  "dependencies": {
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "7.0.2"
  }
}
